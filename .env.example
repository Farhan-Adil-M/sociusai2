# Copy this file to .env and fill in real values. Never commit .env.
#
# ============================================================================
# THE ENVIRONMENT CONTRACT
# ============================================================================
# This file lists EVERY variable the code reads, whether it is required in
# development and/or production, and a safe placeholder. Nothing here is a
# real secret — only replace what you need, and only in your own .env.
#
#   Required   — the app refuses to start (or cannot work) without it.
#   Optional   — has a working default; the app runs unchanged without it.
#   Platform   — set BY Vercel/the OS. Do NOT put these in .env.
#
# Check a real environment at any time with:
#     node scripts/env-check.mjs
# It prints names and safe indicators only — never a value — and exits
# non-zero when the environment cannot work.
#
# Production = the Vercel deployment of `sociusai2` (Vercel sets VERCEL=1,
# and NODE_ENV=production). There is no persistent filesystem there, so the
# local SQLite database and the local Chroma server are BOTH unusable:
# production must configure Supabase Postgres and Chroma Cloud.
# ============================================================================

# ============================================================================
# 1. NVIDIA NIM — the only AI provider. Keys stay on the server, never in the
#    browser or the extension. Verified 2026-10-12 against this account.
# ============================================================================
# Required in dev AND production. The server exits(1) at boot without it.
NIM_API_KEY=nvapi-REPLACE_ME
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NIM_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_ASSESS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Request timeout in ms. Must match the server default (server/config.js: 45000).
NIM_TIMEOUT_MS=45000

# --- Task → model overrides for the multi-model router ---------------------
# Optional. Each AI_* variable OVERRIDES the matching NIM_* value when set.
# Unset ⇒ the effective model is exactly the NIM_* one, so an existing .env
# needs no change. Only set one if you deliberately want a different model for
# that task. (server/services/aiRouter.js reads config.aiRouter.*)
#AI_TUTOR_MODEL=
#AI_ASSESS_MODEL=
#AI_EMBED_MODEL=

# --- Retrieval quality (tutor only) ----------------------------------------
# Evidence discipline: generation is breadth-first and flags weakEvidence.
# Absolute sanity bound + relative share of the strongest hit.
RAG_MIN_SIMILARITY=0.1
RAG_RELATIVE_KEEP=0.5
# Extension highlighter: minimum cosine similarity for a page sentence to earn
# a highlight. Calibrated live (2026-10-14): the embedding model is
# anisotropic — unrelated sentences score ~0.70-0.72 against a small corpus
# while near-verbatim study text scores ~0.92, so 0.80 separates them.
EXTENSION_MIN_SIMILARITY=0.8

# ============================================================================
# 2. Supabase — accounts + durable storage. THE PRODUCTION REQUIREMENT.
# ============================================================================
# All three are OPTIONAL in development (without them the app runs in
# single-user prototype mode with a local database).
# ALL THREE ARE REQUIRED in production:
#   SUPABASE_URL + SUPABASE_ANON_KEY  → real accounts. Without them the boot
#     REFUSES to start: prototype mode has no authentication and one shared
#     user, and server/middleware/auth.js blocks it under NODE_ENV=production
#     unless ALLOW_PROTOTYPE_AUTH=true is set deliberately (never do that on an
#     internet-facing deployment).
#   SUPABASE_DB_URL → durable Postgres (schema v8, already migrated on the
#     hosted database). Without it production would fall back to SQLite in
#     /tmp, which is wiped on every cold start: every account, source, quiz
#     and deck would silently disappear.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Direct Postgres connection string (Supabase → Project Settings → Database).
# postgresql://…  Use the POOLER (port 6543, pgbouncer) for serverless.
SUPABASE_DB_URL=

# --- Turso / libSQL (optional alternative hosted engine) -------------------
# Optional in dev and prod: a hosted libSQL database instead of the local
# file. NOT needed when SUPABASE_DB_URL is set — Supabase wins. When set,
# `npm run migrate` must have been applied to it once. Requires BOTH values;
# setting the URL without the token fails the boot on purpose.
#TURSO_DATABASE_URL=
#TURSO_AUTH_TOKEN=

# ============================================================================
# 3. ChromaDB — the vector store for searchable passages.
# ============================================================================
# Preferred: Chroma Cloud (set the key; tenant + database optional).
# REQUIRED in production: Vercel has no local network, so the local Chroma
# server at CHROMA_LOCAL_HOST:CHROMA_LOCAL_PORT cannot be reached. Without a
# key the SQLite fallback (vector_chunks table) keeps the app working, but on
# Vercel that table lives in ephemeral /tmp storage and is lost on cold start.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=socius_chunks
# Local fallback server settings — used only when CHROMA_API_KEY is empty
# (see README "Local Chroma fallback"). NEVER reachable on Vercel.
CHROMA_LOCAL_HOST=localhost
CHROMA_LOCAL_PORT=8100

# --- Vector store selection (optional) -------------------------------------
# 'chroma | sqlite — auto-selected; force to test the other backend'.
# Leave unset for the automatic choice: Chroma locally, and on Vercel the SQLite
# fallback when no Chroma Cloud key is configured. Setting an unknown value is
# treated as unset.
#VECTOR_STORE=

# ============================================================================
# 4. Local database paths (development only)
# ============================================================================
# Local engine db path. Development default: data/app.db (git-ignored).
# On Vercel this is EPHEMERAL (/tmp/socius-app.db) — that is why production
# must set SUPABASE_DB_URL. This script warns loudly if SQLITE_DB_PATH is set
# in an environment where it cannot persist.
SQLITE_DB_PATH=data/app.db
# Directory for runtime data (default: data).
DATA_DIR=data

# ============================================================================
# 5. Server
# ============================================================================
PORT=3000
MAX_UPLOAD_MB=25
# Interface to bind. 127.0.0.1 = this machine only (default, recommended).
# Set your LAN IP or 0.0.0.0 to allow other devices on the same network —
# the app has no authentication in prototype mode, so only do this on a
# network you trust. Ignored on Vercel (the platform owns the listener).
BIND_HOST=127.0.0.1

# ============================================================================
# 6. Uploads
# ============================================================================
# Cap for the direct-to-Storage upload path (browser → Supabase Storage →
# /api/sources/storage-ingest). Used on serverless deployments where the
# platform request-body cap (~4.5 MB) blocks big multipart uploads.
MAX_STORAGE_UPLOAD_MB=25
# Zip-bomb guard for Office uploads (uncompressed bytes). Optional.
#ZIP_MAX_UNCOMPRESSED_MB=100

# ============================================================================
# 7. Authentication (development / hardening)
# ============================================================================
# Optional escape hatch: allows the no-auth single-user prototype mode under
# NODE_ENV=production. Default unset/false. Leave it unset in production —
# prototype mode means every request is the same user with no password.
#ALLOW_PROTOTYPE_AUTH=
# Login/refresh rate limits (per client IP and per subject). Defaults shown.
#AUTH_RATE_WINDOW_MS=900000
#AUTH_RATE_MAX_IP=30
#AUTH_RATE_MAX_SUBJECT=8

# ============================================================================
# 8. Media: YouTube captions + image OCR (optional)
# ============================================================================
# Intentionally unused: /api/media/youtube reads captions through YouTube's
# keyless innertube path, so the route works without any key. Set it only if
# you switch that path to the official API.
#YOUTUBE_API_KEY=
# Image → text engine. 'tesseract' is the only supported value today.
OCR_ENGINE=tesseract
# Largest file the in-app viewer streams inline, in MB.
VIEWER_MAX_MB=25
# YouTube transcript tunables (defaults shown).
#YOUTUBE_TIMEOUT_MS=15000
#YOUTUBE_SEGMENT_SECONDS=30
#YOUTUBE_SEGMENT_MAX_CHARS=600
#YOUTUBE_MAX_TRACK_BYTES=16
# OCR tunables (defaults shown). OCR_LANG_PATH points at a directory holding
# eng.traineddata or eng.traineddata.gz — the code never falls back to a CDN
# download once a local file exists, so on Vercel that directory must be
# inside the bundle (see vercel.json includeFiles, which ships the
# @tesseract.js-data/eng package for exactly this). Both the plain file and
# the .gz are accepted; the engine is told which name to request.
#OCR_TIMEOUT_MS=45000
#OCR_MAX_FILE_MB=25
#OCR_MAX_PIXELS=40000000
#OCR_LANG_PATH=./node_modules/.tesseract-lang
#OCR_LANG_PATH=./node_modules/@tesseract.js-data/eng/4.0.0
#OCR_LANG_CACHE=

# ============================================================================
# 9. Sharing a link into the app (optional)
# ============================================================================
# Document-fetch timeout (ms) when a shared link points at a real file.
#SHARE_FETCH_TIMEOUT_MS=15000
# Sandbox-only escape hatch for the private-host SSRF blocklist. NEVER true in
# production: it lets the server fetch from localhost/private addresses.
#SHARE_ALLOW_PRIVATE_HOSTS=

# ============================================================================
# 10. Local scripts (optional)
# ============================================================================
# Base URLs targeted by scripts/eval-retrieval.mjs (EVAL_BASE_URL),
# scripts/e2e-smoke.mjs (SMOKE_BASE_URL) and scripts/e2e-*.mjs
# (E2E_BASE_URL, default http://127.0.0.1:7000).
EVAL_BASE_URL=http://localhost:3000
SMOKE_BASE_URL=http://localhost:3000
# Credentials for the two-user auth/e2e scripts (never a real account here).
#E2E_BASE_URL=http://127.0.0.1:7000
#E2E_U1_EMAIL=
#E2E_U1_PASSWORD=
#E2E_U2_EMAIL=
#E2E_U2_PASSWORD=

# ============================================================================
# 11. Platform variables — set BY Vercel or the shell. Do NOT write these
#     into .env: they are injected by the runtime and are read-only here.
# ============================================================================
#   VERCEL    = 1   → present on every Vercel function invocation. The vector
#                     store uses it to pick the SQLite fallback when no Chroma
#                     Cloud key is configured. Locally it is absent.
#   NODE_ENV  = production → set by Vercel in production builds. The auth
#                     prototype-mode gate reads it; local dev leaves it unset.
# Both are read by node itself/the platform; listing them here is documentation
# only. scripts/env-check.mjs reports how it detected the environment from them.
