# Copy this file to .env and fill in real values. Never commit .env.

# --- NVIDIA NIM (verified 2026-10-12 against this account) ---
NIM_API_KEY=nvapi-REPLACE_ME
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NIM_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_ASSESS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Request timeout in ms. Must match the server default (server/config.js: 45000).
NIM_TIMEOUT_MS=45000

# Evidence discipline (tutor only; generation is breadth-first and flags
# weakEvidence). Absolute sanity bound + relative share of the strongest hit.
RAG_MIN_SIMILARITY=0.1
RAG_RELATIVE_KEEP=0.5

# --- ChromaDB ---
# Preferred: Chroma Cloud (set all four).
# Fallback: leave these empty and start the local server (see README "Local Chroma fallback").
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=socius_chunks
# Local fallback server settings (used when CHROMA_API_KEY is empty):
CHROMA_LOCAL_HOST=localhost
CHROMA_LOCAL_PORT=8100

# --- Vector store selection (optional) ---
# 'chroma | sqlite — auto-selected; force to test the other backend'.
# Leave unset for the automatic choice (see docs/API_CONTRACT.md v1.3).
#VECTOR_STORE=

# --- Database engine & paths (optional) ---
# Hosted Turso/libSQL database (optional — config-free local dev works without
# these; when set, `npm run migrate` must have been applied to it once).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local engine db path; serverless (Vercel) uses /tmp/socius-app.db.
SQLITE_DB_PATH=data/app.db
# Directory for runtime data (default: data).
DATA_DIR=data

# --- Server ---
PORT=3000
MAX_UPLOAD_MB=25
# Cap for the direct-to-Storage upload path (browser → Supabase Storage →
# /api/sources/storage-ingest). Used on serverless deployments where the
# platform request-body cap (~4.5 MB) blocks big multipart uploads.
MAX_STORAGE_UPLOAD_MB=25
# Interface to bind. 127.0.0.1 = this machine only (default, recommended).
# Set your LAN IP or 0.0.0.0 to allow other devices on the same network —
# the app has no authentication, so only do this on a network you trust.
BIND_HOST=127.0.0.1

# --- Scripts (optional) ---
# Base URLs targeted by scripts/eval-retrieval.mjs (EVAL_BASE_URL) and
# scripts/e2e-smoke.mjs (SMOKE_BASE_URL); both default to http://localhost:3000.
EVAL_BASE_URL=http://localhost:3000
SMOKE_BASE_URL=http://localhost:3000
